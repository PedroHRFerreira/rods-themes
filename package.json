{
  "name": "rods-themes",
  "displayName": "Rods Themes",
  "description": "Cinco temas escuros: três com preto absoluto e cores vibrantes, e dois com tons de grafite e contraste mais suave.",
  "version": "0.1.0",
  "publisher": "PedroHRFerreira",
  "license": "MIT",
  "author": {
    "name": "PedroHRFerreira",
    "url": "https://github.com/PedroHRFerreira"
  },
  "homepage": "https://github.com/PedroHRFerreira",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroHRFerreira/rods-themes.git"
  },
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node --import tsx src/build.ts",
    "build:jetbrains": "node --import tsx src/jetbrains/build.ts",
    "check": "tsc --noEmit",
    "line-check": "node --import tsx src/scripts/line-check.ts",
    "rods": "rods",
    "rods:init": "rods init .",
    "rods:sync": "rods adapter sync . --target codex --codex-skills-dir .codex/skills",
    "rods:doctor": "rods adapter doctor . --target codex",
    "rods:upgrade": "rods upgrade .",
    "rods:upgrade:dry-run": "rods upgrade . --dry-run",
    "context:project:add": "node --import tsx src/scripts/context-command.ts project add rods-themes .",
    "context:ingest": "node --import tsx src/scripts/context-command.ts ingest .",
    "context:ingest:review": "node --import tsx src/scripts/context-command.ts ingest . --scope review",
    "context:stats": "node --import tsx src/scripts/context-command.ts stats",
    "context:search": "node --import tsx src/scripts/context-command.ts search",
    "context:read": "node --import tsx src/scripts/context-command.ts read",
    "validate": "npm run check && npm run build:all && npm test && npm run line-check",
    "package": "npm run build && vsce package",
    "build:zed": "node --import tsx src/zed/build.ts",
    "build:all": "npm run build && npm run build:jetbrains && npm run build:zed",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "package:all": "npm run validate && npm run package",
    "preview": "npm run build && node --import tsx src/scripts/preview.ts"
  },
  "contributes": {
    "themes": [
      {
        "label": "Rods Black Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/black-neon-color-theme.json"
      },
      {
        "label": "Rods Black Emerald",
        "uiTheme": "vs-dark",
        "path": "./themes/black-emerald-color-theme.json"
      },
      {
        "label": "Rods Black Ember",
        "uiTheme": "vs-dark",
        "path": "./themes/black-ember-color-theme.json"
      },
      {
        "label": "Rods Dark Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-graphite-color-theme.json"
      },
      {
        "label": "Rods Dark Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-midnight-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@pedrohrferreira/rods-sdk": "^0.1.8",
    "@types/node": "^26.0.0",
    "@vscode/vsce": "^3.9.2",
    "ajv": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  }
}
