{
  "name": "rods-themes",
  "displayName": "Rods Themes",
  "description": "Temas dark/neon para VS Code inspirados nas seleções da Copa do Mundo.",
  "version": "0.0.4",
  "publisher": "PedroHRFerreira",
  "license": "MIT",
  "author": {
    "name": "PedroHRFerreira",
    "url": "https://github.com/PedroHRFerreira"
  },
  "homepage": "https://github.com/PedroHRFerreira",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroHRFerreira/rods-themes.git"
  },
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node --import tsx src/build.ts",
    "build:jetbrains": "node --import tsx src/jetbrains/build.ts",
    "check": "tsc --noEmit",
    "line-check": "node --import tsx src/scripts/line-check.ts",
    "rods": "rods",
    "rods:init": "rods init .",
    "rods:sync": "rods adapter sync . --target codex --codex-skills-dir .codex/skills",
    "rods:doctor": "rods adapter doctor . --target codex",
    "rods:upgrade": "rods upgrade .",
    "rods:upgrade:dry-run": "rods upgrade . --dry-run",
    "context:project:add": "node --import tsx src/scripts/context-command.ts project add rods-themes .",
    "context:ingest": "node --import tsx src/scripts/context-command.ts ingest .",
    "context:ingest:review": "node --import tsx src/scripts/context-command.ts ingest . --scope review",
    "context:stats": "node --import tsx src/scripts/context-command.ts stats",
    "context:search": "node --import tsx src/scripts/context-command.ts search",
    "context:read": "node --import tsx src/scripts/context-command.ts read",
    "validate": "npm run build && npm run check && npm run line-check",
    "package": "npm run build && vsce package"
  },
  "contributes": {
    "themes": [
