  "tokenColors": [
    {"name":"Comment","scope":["comment","punctuation.definition.comment"],"settings":{"foreground":"#828BB8","fontStyle":"italic"}},
    {"name":"Keyword","scope":["keyword","storage.type","storage.modifier"],"settings":{"foreground":"#82AAFF"}},
    {"name":"Function","scope":["entity.name.function","support.function"],"settings":{"foreground":"#89DDFF"}},
    {"name":"Method","scope":["entity.name.function.member","meta.method"],"settings":{"foreground":"#FFCB6B"}},
    {"name":"Variable","scope":["variable","meta.definition.variable"],"settings":{"foreground":"#C8D3F5"}},
    {"name":"Parameter","scope":["variable.parameter","meta.parameter"],"settings":{"foreground":"#C3E88D"}},
    {"name":"Type","scope":["entity.name.type","support.type","entity.name.class"],"settings":{"foreground":"#C792EA"}},
    {"name":"Interface","scope":["entity.name.type.interface"],"settings":{"foreground":"#C792EA","fontStyle":"italic"}},
    {"name":"String","scope":["string","constant.other.symbol"],"settings":{"foreground":"#C3E88D"}},
    {"name":"Number","scope":["constant.numeric","constant.language.boolean"],"settings":{"foreground":"#C792EA"}},
    {"name":"Property","scope":["variable.other.property","support.variable.property"],"settings":{"foreground":"#FFCB6B"}},
    {"name":"Operator","scope":["keyword.operator","punctuation.accessor"],"settings":{"foreground":"#82AAFF"}},
    {"name":"Tag","scope":["entity.name.tag","entity.other.attribute-name"],"settings":{"foreground":"#82AAFF"}},
    {"name":"Invalid","scope":["invalid","invalid.illegal"],"settings":{"foreground":"#FF757F","fontStyle":"bold"}}
  ],
  "semanticTokenColors": {
    "variable": "#C8D3F5",
    "parameter": "#C3E88D",
    "property": "#FFCB6B",
    "function": "#89DDFF",
    "method": "#FFCB6B",
    "class": "#C792EA",
    "interface": {"foreground":"#C792EA","fontStyle":"italic"},
    "enum": "#C792EA",
    "type": "#C792EA",
    "keyword": "#82AAFF",
    "string": "#C3E88D",
    "number": "#C792EA",
    "comment": {"foreground":"#828BB8","fontStyle":"italic"},
    "decorator": "#82AAFF",
    "namespace": "#89DDFF",
    "variable.readonly": "#C792EA",
    "function.declaration": "#89DDFF",
    "*.deprecated": {"foreground":"#828BB8","strikethrough":true}
  }
