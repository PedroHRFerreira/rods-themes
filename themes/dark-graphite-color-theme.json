  "tokenColors": [
    {"name":"Comment","scope":["comment","punctuation.definition.comment"],"settings":{"foreground":"#7E8993","fontStyle":"italic"}},
    {"name":"Keyword","scope":["keyword","storage.type","storage.modifier"],"settings":{"foreground":"#FF8F40"}},
    {"name":"Function","scope":["entity.name.function","support.function"],"settings":{"foreground":"#78DCE8"}},
    {"name":"Method","scope":["entity.name.function.member","meta.method"],"settings":{"foreground":"#FFD866"}},
    {"name":"Variable","scope":["variable","meta.definition.variable"],"settings":{"foreground":"#BCBEC4"}},
    {"name":"Parameter","scope":["variable.parameter","meta.parameter"],"settings":{"foreground":"#A9DC76"}},
    {"name":"Type","scope":["entity.name.type","support.type","entity.name.class"],"settings":{"foreground":"#AB9DF2"}},
    {"name":"Interface","scope":["entity.name.type.interface"],"settings":{"foreground":"#AB9DF2","fontStyle":"italic"}},
    {"name":"String","scope":["string","constant.other.symbol"],"settings":{"foreground":"#A9DC76"}},
    {"name":"Number","scope":["constant.numeric","constant.language.boolean"],"settings":{"foreground":"#AB9DF2"}},
    {"name":"Property","scope":["variable.other.property","support.variable.property"],"settings":{"foreground":"#FFD866"}},
    {"name":"Operator","scope":["keyword.operator","punctuation.accessor"],"settings":{"foreground":"#FF8F40"}},
    {"name":"Tag","scope":["entity.name.tag","entity.other.attribute-name"],"settings":{"foreground":"#FF8F40"}},
    {"name":"Invalid","scope":["invalid","invalid.illegal"],"settings":{"foreground":"#FF6188","fontStyle":"bold"}}
  ],
  "semanticTokenColors": {
    "variable": "#BCBEC4",
    "parameter": "#A9DC76",
    "property": "#FFD866",
    "function": "#78DCE8",
    "method": "#FFD866",
    "class": "#AB9DF2",
    "interface": {"foreground":"#AB9DF2","fontStyle":"italic"},
    "enum": "#AB9DF2",
    "type": "#AB9DF2",
    "keyword": "#FF8F40",
    "string": "#A9DC76",
    "number": "#AB9DF2",
    "comment": {"foreground":"#7E8993","fontStyle":"italic"},
    "decorator": "#FF8F40",
    "namespace": "#78DCE8",
    "variable.readonly": "#AB9DF2",
    "function.declaration": "#78DCE8",
    "*.deprecated": {"foreground":"#7E8993","strikethrough":true}
  }
